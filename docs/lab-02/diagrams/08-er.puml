@startuml

hide circle
skinparam linetype ortho
skinparam entity {
    BackgroundColor #F0F6FC
    BorderColor #6B9BD2
}

' =========================
' СУЩНОСТИ
' =========================

entity INTENT {
    * id : UUID <<PK>>
    title : TEXT
    status : TEXT
    created_at : TIMESTAMP
    completed_at : TIMESTAMP?
}

entity REQUIREMENT {
    * id : UUID <<PK>>
    intent_id : UUID <<FK>>
    type : TEXT
    operator : TEXT
    value : TEXT
}

entity PLACE {
    * id : UUID <<PK>>
    name : TEXT
    latitude : DECIMAL
    longitude : DECIMAL
    radius_meters : DECIMAL
    role : TEXT
}

entity SEMANTIC_BINDING {
    * semantic_name : TEXT <<PK>>
    place_id : UUID <<FK>>
    source : TEXT
}

entity PLACE_VISIT {
    * id : UUID <<PK>>
    place_id : UUID <<FK>>
    state : TEXT
    entered_at : TIMESTAMP
    confirmed_at : TIMESTAMP?
    exited_at : TIMESTAMP?
}

entity INTENT_SUPPRESSION {
    * intent_id : UUID <<PK, FK>>
    * visit_id : UUID <<PK, FK>>
    mode : TEXT
    created_at : TIMESTAMP
}

entity NOTIFICATION_GROUP {
    * visit_id : UUID <<PK, FK>>
    * context_key : TEXT <<PK>>
    reserved_at : TIMESTAMP
    sent_at : TIMESTAMP?
}

entity EVENT {
    * id : UUID <<PK>>
    visit_id : UUID? <<FK>>
    type : TEXT
    timestamp : TIMESTAMP
    payload_json : TEXT
}

' =========================
' СВЯЗИ МЕЖДУ СУЩНОСТЯМИ
' =========================

INTENT ||--|{ REQUIREMENT : has

INTENT ||--o{ INTENT_SUPPRESSION : has

PLACE ||--o{ SEMANTIC_BINDING : resolves

PLACE ||--o{ PLACE_VISIT : has

PLACE_VISIT ||--o{ INTENT_SUPPRESSION : scopes

PLACE_VISIT ||--o{ NOTIFICATION_GROUP : deduplicates

PLACE_VISIT |o--o{ EVENT : explains

@enduml
