@startuml
title Жизненный цикл одного посещения места
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam state {
  BackgroundColor #EAF2F9
  BorderColor #2D70B2
  ArrowColor #35536E
}

state "Визит начат\nждём 60 секунд" as Candidate
state "Визит подтверждён\nможно показать дела" as Confirmed
state "Визит завершён" as Ended

[*] --> Candidate : Телефон зафиксировал вход
Candidate --> Confirmed : Остался в месте 60 секунд
Candidate --> Ended : Вышел раньше 60 секунд
Confirmed --> Ended : Вышел и не вернулся 60 секунд
Ended --> [*]
@enduml
