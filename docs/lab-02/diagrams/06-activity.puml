@startuml
title Общая диаграмма деятельности приложения GoCue

start

:Запуск приложения;

switch (Выбор сценария)

case (UC-01 Создать или изменить намерение)
    :Открыть раздел намерений;
    if (Изменить существующее?) then (да)
        :Выбрать намерение;
        :Изменить параметры;
    else (нет)
        :Создать новое намерение;
    endif
    :Проверить данные;
    if (Данные корректны?) then (да)
        :Сохранить намерение;
    else (нет)
        :Исправить ошибки;
        :Повторить проверку и сохранение;
    endif

case (UC-02 Настроить место)
    :Открыть настройки мест;
    if (Место существует?) then (да)
        :Выбрать место;
    else (нет)
        :Создать место;
    endif
    :Указать название и координаты;
    :Установить радиус геозоны;
    :Указать роль места;
    :Проверить и сохранить настройки;

case (UC-03 Получить список дел)
    :Открыть список дел;
    :Определить текущее место;
    :Собрать ContextSnapshot;
    :Выполнить UC-10;
    if (Есть подходящие дела?) then (да)
        :Отобразить список дел;
    else (нет)
        :Сообщить об отсутствии дел;
    endif

case (UC-04 Завершить дело)
    :Открыть список дел;
    :Выбрать дело;
    :Подтвердить завершение;
    if (Подтверждение получено?) then (да)
        :Изменить статус на COMPLETED;
        :Сохранить изменения;
    else (нет)
        :Отменить операцию;
    endif

case (UC-05 Перенести дело)
    :Открыть список дел;
    :Выбрать дело;
    :Выбрать перенос на следующий визит;
    if (Перенос подтверждён?) then (да)
        :Сохранить перенос;
        :Исключить дело из текущего показа;
    else (нет)
        :Отменить перенос;
    endif

case (UC-06 Просмотреть причину срабатывания)
    :Открыть историю уведомлений;
    :Выбрать уведомление;
    :Запросить запись события;
    if (Запись найдена?) then (да)
        :Получить данные события;
        :Определить причину срабатывания;
        :Показать причину пользователю;
    else (нет)
        :Сообщить об отсутствии информации;
    endif

case (UC-08 Обработать событие геозоны)
    :Получить событие от Android OS;

    if (Событие поддерживается?) then (да)

        ' UC-09
        :UC-09 Определить подходящее место;
        :Получить координаты пользователя;
        :Сопоставить координаты с геозонами;

        if (Подходящее место найдено?) then (да)
            :Получить идентификатор места;
        else (нет)
            :Зафиксировать отсутствие подходящего места;
        endif

        :Собрать ContextSnapshot;

        ' UC-10
        :UC-10 Сформировать список дел;
        :Получить активные намерения;
        :Проверить требования;
        :Проверить подавления;
        :Сформировать список подходящих дел;

        ' UC-11
        :UC-11 Записать событие в журнал;
        :Создать запись события;
        :Сохранить запись;

        ' UC-12
        :UC-12 Отправить групповое уведомление;

        if (Есть подходящие дела?) then (да)
            :Проверить ключ группы;
            if (Ключ уже сохранён?) then (да)
                :Не повторять уведомление;
            else (нет)
                :Атомарно сохранить ключ;
                :Сформировать уведомление;
                :Передать уведомление Android OS;
                :Зафиксировать результат отправки;
            endif
        else (нет)
            :Не отправлять уведомление;
        endif

    else (нет)
        :Игнорировать неподдерживаемое событие;
    endif

endswitch

:Завершение сценария;

stop
@enduml
