      datetime created_at
    }
    NOTIFICATION_GROUP {
      uuid visit_id PK,FK
      string context_key PK
      datetime reserved_at
      datetime sent_at
    }
    EVENT {
      uuid id PK
      uuid visit_id FK
      string type
      datetime timestamp
