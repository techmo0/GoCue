@startuml
title Контекстная диаграмма IDEF0 · A-0
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam rectangleBorderColor white
skinparam rectangleFontColor #1E3349
skinparam rectangle<<function>>BorderColor #2D70B2
skinparam ArrowColor #34536F
skinparam linetype ortho
skinparam nodesep 32
skinparam ranksep 130
hide stereotype

rectangle "Возвращать намерения\nв подходящем месте\n\n\n\n\n\n\n\n0" as A0 <<function>> #EDF5FC

rectangle "Намерения пользователя" as I1 #white
rectangle "Настройки мест" as I2 #white
rectangle "События геозон ENTER / EXIT" as I3 #white
rectangle " " as C1 #white
rectangle " " as C2 #white
rectangle " " as C3 #white
rectangle "Список подходящих дел" as O1 #white
rectangle "Групповое уведомление" as O2 #white
rectangle "Запись в журнале событий" as O3 #white
rectangle " " as M1 #white
rectangle " " as M2 #white
rectangle " " as M3 #white
rectangle " " as M4 #white

I1 -right-> A0
I2 -right-> A0
I3 -right-> A0

C1 -down-> A0 : <img:labels/control-permission.png>
C2 -down-> A0 : <img:labels/control-rules.png>
C3 -down-> A0 : <img:labels/control-dwell.png>

A0 -right-> O1
A0 -right-> O2
A0 -right-> O3

M1 -up-> A0 : <img:labels/mechanism-app.png>
M2 -up-> A0 : <img:labels/mechanism-geofence.png>
M3 -up-> A0 : <img:labels/mechanism-notification.png>
M4 -up-> A0 : <img:labels/mechanism-db.png>
@enduml
