@startuml
left to right direction

actor "Пользователь" as User
actor "Android OS" as Android

rectangle "GoCue" {

  usecase "UC-01\nСоздать или изменить\nнамерение" as UC01

  usecase "UC-02\nНастроить место" as UC02

  usecase "UC-03\nПолучить список дел\nпри посещении места" as UC03

  usecase "UC-04\nЗавершить дело" as UC04

  usecase "UC-05\nПеренести дело\nна следующий визит" as UC05

  usecase "UC-06\nПросмотреть причину\nсрабатывания" as UC06

  usecase "Обработать событие\nгеозоны" as UC08

  usecase "Определить\nподходящее место" as UC09

  usecase "Сформировать\nсписок дел" as UC10

  usecase "Записать событие\nв журнал" as UC11

  usecase "Отправить групповое\nуведомление" as UC12
}

User -- UC01
User -- UC02
User -- UC03
User -- UC04
User -- UC05
User -- UC06

Android -- UC08
Android -- UC12

UC08 ..> UC09 : <<include>>
UC08 ..> UC10 : <<include>>
UC08 ..> UC11 : <<include>>
UC08 ..> UC12 : <<include>>

UC03 ..> UC10 : <<include>>

@enduml
